<?xml version="1.0" encoding="utf-8"?>
<!-- Full-trust helper that ships inside the DiscordBar package (desktop:Extension windows.fullTrustProcess).
     Installs a low-level keyboard hook, forwards the push-to-talk keys to the widget over the package's
     app service and swallows them so they never leak into games. Classic .NET Framework project: no NuGet,
     WinRT comes straight from Windows.winmd. -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7D1E2C3A-9B4F-4E6A-8C2D-5F0A1B2C3D4E}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DiscordBar.KeyHelper</RootNamespace>
    <AssemblyName>DiscordBar.KeyHelper</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateManifests>false</GenerateManifests>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime" />
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="Windows">
      <HintPath>C:\Program Files (x86)\Windows Kits\10\UnionMetadata\10.0.22621.0\Windows.winmd</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
